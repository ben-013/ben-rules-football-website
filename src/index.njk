---
layout: layouts/base.njk
title: Home
---
{% for post in collections.posts | reverse %}
<article class="post-preview">
  <h2><a href="{{ post.url }}">{{ post.data.title }}{% if post.data.category %} | {{ post.data.category }}{% endif %}</a></h2>
  <div class="meta">{{ post.data.author }} · {{ post.date | dateDisplay }}</div>
  <p>{{ post.data.description }}</p>
  <p><a href="{{ post.url }}">Read the full article →</a></p>
</article>
{% endfor %}
